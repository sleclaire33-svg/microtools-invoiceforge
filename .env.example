PAYPAL_CLIENT_ID=your_live_or_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_live_or_sandbox_client_secret
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=after_you_create_the_webhook
FULFILLMENT_SIGNING_SECRET=generate_a_long_random_secret
# Optional migration: exact validated release ZIP, base64 encoded. Server-only; never commit its value.
