# Remains false until a completed sandbox purchase and explicit go-live approval.
CHECKOUT_LIVE_ENABLED=false

# 32-byte AES key generated by scripts/package-encrypted-downloads.js; server-only.
MTS_DOWNLOAD_KEY=
